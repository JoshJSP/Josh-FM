# Spotify playback/auth public configuration
SPOTIFY_CLIENT_ID=

# Car Mode navigatie (Mapbox Directions + Geocoding).
# Publiek pk.-token: wordt runtime via /api/config aan de client gegeven.
MAPBOX_PUBLIC_TOKEN=

# Existing discovery and category-classification routes
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini

# MAIRFM 1.0 DJ Writer
GROQ_API_KEY=
# Optional; defaults to the release-tested model chain.
GROQ_DJ_MODEL=

# MAIRFM 1.0 DJ-stem
FISH_AUDIO_API_KEY=
# Optional release overrides. Leave blank to use the tested defaults.
FISH_AUDIO_MODEL=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_VOICE_JOSH=
FISH_AUDIO_VOICE_MAYA=
FISH_AUDIO_VOICE_MAX=
FISH_AUDIO_VOICE_NOAH=
