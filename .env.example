# Spotify playback/auth public configuration
SPOTIFY_CLIENT_ID=

# Car Mode navigatie (Mapbox Directions + Geocoding).
# Publiek pk.-token: wordt runtime via /api/config aan de client gegeven.
MAPBOX_PUBLIC_TOKEN=

# MAIRFM AI-schrijver. Claude is primair voor DJ-copy, nieuws, discovery en
# de categoriefilters. Zonder deze sleutel doet Groq het werk.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5. Pick a model that supports
# output_config.effort (Claude 4.6 and newer).
ANTHROPIC_TEXT_MODEL=

# MAIRFM 1.0 DJ Writer, nu het vangnet achter Claude.
GROQ_API_KEY=
# Optional; defaults to the release-tested model chain.
GROQ_DJ_MODEL=

# MAIRFM 1.0 DJ-stem
FISH_AUDIO_API_KEY=
# Optional release overrides. Leave blank to use the tested defaults.
FISH_AUDIO_MODEL=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_VOICE_JOSH=
FISH_AUDIO_VOICE_MAYA=
FISH_AUDIO_VOICE_MAX=
FISH_AUDIO_VOICE_NOAH=
